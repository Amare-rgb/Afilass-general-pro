# PostgreSQL connection string
DATABASE_URL="postgresql://afilas_user:afilas_pass@localhost:5432/afilas_hospital?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CLIENT_URL="http://localhost:3000"

# Email (SMTP) - reminders + contact form
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="Afilas General Hospital <no-reply@afilaspmms.com>"

# Reminder job: hours before appointment to send the reminder email
REMINDER_HOURS_BEFORE=24

# Initial superadmin (used by prisma/seed.js)
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@afilaspmms.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
